INDEXESTYLE = (
    <style>
        :root {{
            --bg: #0f172a;
            --accent: #38bdf8;
            --python-gold: #ffde57;
            --python-blue: #4584b6;
            --text: #f1f5f9;
            --text-dim: #94a3b8;
            --card-bg: #1e293b;
            --code-bg: #000000;
        }}

        * {{ margin: 0; padding: 0; box-sizing: border-box; }}

        body {{
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
            color: var(--text);
            line-height: 1.6;
            overflow-x: hidden;
        }}

        .container {{ max-width: 1000px; margin: 0 auto; padding: 0 2rem; }}

        /* Navbar */
        nav {{
            padding: 2rem 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }}
        .logo {{ font-weight: 800; font-size: 1.5rem; letter-spacing: -1px; }}
        .logo span {{ color: var(--accent); }}

        /* Hero Section */
        header {{
            padding: 4rem 0;
            text-align: center;
        }}
        h1 {{ font-size: 4rem; font-weight: 800; margin-bottom: 1rem; line-height: 1.1; }}
        .hero-subtitle {{
            font-size: 1.25rem;
            color: var(--text-dim);
            max-width: 600px;
            margin: 0 auto 2.5rem;
        }}
        .badge {{
            background: rgba(56, 189, 248, 0.1);
            color: var(--accent);
            padding: 0.5rem 1rem;
            border-radius: 99px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            display: inline-block;
        }}

        /* Code Block Mockup */
        .code-window {{
            background: var(--code-bg);
            border-radius: 12px;
            border: 1px solid #334155;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            text-align: left;
            overflow: hidden;
            margin-bottom: 4rem;
        }}
        .code-header {{
            background: #1e293b;
            padding: 0.75rem 1rem;
            display: flex;
            gap: 6px;
        }}
        .dot {{ width: 12px; height: 12px; border-radius: 50%; background: #475569; }}
        .code-content {{
            padding: 1.5rem;
            font-family: 'Fira Code', monospace;
            font-size: 0.9rem;
            color: #d1d5db;
        }}
        .tag {{ color: var(--accent); }}
        .keyword {{ color: #f472b6; }}
        .string {{ color: #4ade80; }}
        .comment {{ color: #64748b; }}

        /* Features */
        .features {{
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin-bottom: 4rem;
        }}
        .feature-card {{
            background: var(--card-bg);
            padding: 2rem;
            border-radius: 1rem;
            border: 1px solid #334155;
        }}
        .feature-card h3 {{ margin-bottom: 0.75rem; color: var(--accent); }}
        .feature-card p {{ color: var(--text-dim); font-size: 0.95rem; }}

        /* CTA */
        .cta-section {{
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            padding: 4rem;
            border-radius: 2rem;
            text-align: center;
            border: 1px dashed #334155;
        }}
        .btn {{
            display: inline-block;
            background: var(--text);
            color: var(--bg);
            padding: 0.75rem 2rem;
            border-radius: 0.5rem;
            text-decoration: none;
            font-weight: 600;
            transition: transform 0.2s;
        }}
        .btn:hover {{ transform: translateY(-2px); }}

        footer {{
            padding: 4rem 0;
            text-align: center;
            color: var(--text-dim);
            font-size: 0.9rem;
        }}
    </style>
)

PROFILESTYLE = (
    <style>
        :root {{
            --bg: #0f172a;
            --accent: #38bdf8;
            --python-gold: #ffde57;
            --python-blue: #4584b6;
            --text: #f1f5f9;
            --text-dim: #94a3b8;
            --card-bg: #1e293b;
            --code-bg: #000000;
            --border: #334155;
            --green: #4ade80;
            --pink: #f472b6;
        }}

        * {{ margin: 0; padding: 0; box-sizing: border-box; }}

        body {{
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
            color: var(--text);
            line-height: 1.6;
            overflow-x: hidden;
        }}

        .container {{ max-width: 1000px; margin: 0 auto; padding: 0 2rem; }}

        /* Navbar */
        nav {{
            padding: 2rem 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }}
        .logo {{ font-weight: 800; font-size: 1.5rem; letter-spacing: -1px; }}
        .logo span {{ color: var(--accent); }}

        /* Search bar */
        .search-section {{
            padding: 3rem 0 2rem;
            text-align: center;
        }}
        .search-section h1 {{
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
            line-height: 1.1;
        }}
        .search-section p {{
            color: var(--text-dim);
            margin-bottom: 2rem;
            font-size: 1rem;
        }}
        .search-form {{
            display: flex;
            gap: 0.75rem;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
        }}
        .search-input {{
            background: var(--card-bg);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 0.75rem 1.25rem;
            border-radius: 0.5rem;
            font-size: 1rem;
            font-family: 'Fira Code', monospace;
            width: 320px;
            outline: none;
            transition: border-color 0.2s;
        }}
        .search-input:focus {{ border-color: var(--accent); }}
        .search-input::placeholder {{ color: var(--text-dim); }}
        .btn {{
            display: inline-block;
            background: var(--text);
            color: var(--bg);
            padding: 0.75rem 2rem;
            border-radius: 0.5rem;
            text-decoration: none;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            font-size: 1rem;
            cursor: pointer;
            border: none;
            transition: transform 0.2s, background 0.2s;
        }}
        .btn:hover {{ transform: translateY(-2px); background: var(--accent); color: var(--bg); }}
        .btn-ghost {{
            background: transparent;
            color: var(--accent);
            border: 1px solid var(--accent);
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }}
        .btn-ghost:hover {{ background: var(--accent); color: var(--bg); transform: none; }}

        /* Error / empty state */
        .state-box {{
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 3rem;
            text-align: center;
            margin: 2rem 0;
        }}
        .state-box .icon {{ font-size: 3rem; margin-bottom: 1rem; }}
        .state-box h2 {{ margin-bottom: 0.5rem; }}
        .state-box p {{ color: var(--text-dim); }}

        /* Profile card */
        .profile-grid {{
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 2rem;
            margin: 2rem 0;
            align-items: start;
        }}
        @media (max-width: 700px) {{
            .profile-grid {{ grid-template-columns: 1fr; }}
        }}

        .profile-card {{
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 1rem;
            padding: 2rem;
            position: sticky;
            top: 1rem;
        }}
        .avatar {{
            width: 100%;
            border-radius: 50%;
            border: 3px solid var(--border);
            margin-bottom: 1rem;
            display: block;
        }}
        .profile-name {{
            font-size: 1.3rem;
            font-weight: 800;
            margin-bottom: 0.15rem;
        }}
        .profile-login {{
            color: var(--text-dim);
            font-family: 'Fira Code', monospace;
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }}
        .profile-bio {{
            font-size: 0.9rem;
            color: var(--text-dim);
            margin-bottom: 1.25rem;
            border-top: 1px solid var(--border);
            padding-top: 1rem;
        }}
        .profile-meta {{
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            font-size: 0.85rem;
            color: var(--text-dim);
            margin-bottom: 1.25rem;
        }}
        .profile-meta span {{ display: flex; align-items: center; gap: 0.4rem; }}
        .profile-meta a {{ color: var(--accent); text-decoration: none; }}
        .profile-meta a:hover {{ text-decoration: underline; }}
        .followers-row {{
            display: flex;
            gap: 1.5rem;
            font-size: 0.85rem;
            border-top: 1px solid var(--border);
            padding-top: 1rem;
        }}
        .followers-row strong {{ color: var(--text); }}
        .followers-row span {{ color: var(--text-dim); }}

        /* Stats row */
        .stats-row {{
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 1.5rem;
        }}
        .stat-card {{
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 0.75rem;
            padding: 1.25rem;
            text-align: center;
        }}
        .stat-value {{
            font-size: 1.8rem;
            font-weight: 800;
            font-family: 'Fira Code', monospace;
            color: var(--accent);
            line-height: 1;
            margin-bottom: 0.25rem;
        }}
        .stat-label {{
            font-size: 0.75rem;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }}

        /* Repos */
        .section-title {{
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }}
        .repos-grid {{
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 2rem;
        }}
        @media (max-width: 600px) {{
            .repos-grid {{ grid-template-columns: 1fr; }}
            .stats-row {{ grid-template-columns: 1fr 1fr; }}
        }}
        .repo-card {{
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 0.75rem;
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            transition: border-color 0.2s, transform 0.2s;
        }}
        .repo-card:hover {{ border-color: var(--accent); transform: translateY(-2px); }}
        .repo-name {{
            font-family: 'Fira Code', monospace;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--accent);
            text-decoration: none;
        }}
        .repo-name:hover {{ text-decoration: underline; }}
        .repo-desc {{
            font-size: 0.82rem;
            color: var(--text-dim);
            flex: 1;
        }}
        .repo-meta {{
            display: flex;
            gap: 1rem;
            font-size: 0.78rem;
            color: var(--text-dim);
            align-items: center;
            flex-wrap: wrap;
        }}
        .lang-dot {{
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--python-gold);
            margin-right: 3px;
        }}
        .badge {{
            background: rgba(56, 189, 248, 0.1);
            color: var(--accent);
            padding: 0.25rem 0.6rem;
            border-radius: 99px;
            font-size: 0.72rem;
            font-weight: 600;
        }}

        footer {{
            padding: 4rem 0;
            text-align: center;
            color: var(--text-dim);
            font-size: 0.9rem;
            border-top: 1px solid var(--border);
            margin-top: 2rem;
        }}
    </style>
)